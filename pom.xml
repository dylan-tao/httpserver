<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.robaho</groupId>
    <artifactId>httpserver</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>HttpServer</name>
    <description>A zero dependency implementation of the JDK httpserver designed for Virtual Threads. Includes websocket and Http2 support.</description>
    <url>https://github.com/robaho/httpserver</url>

    <licenses>
        <license>
            <name>gnu v2.0 with classpath exception</name>
            <url>https://www.gnu.org/software/classpath/license.html</url>
        </license>
        <license>
            <name>nanohttpd</name>
            <url>https://github.com/NanoHttpd/nanohttpd/blob/efb2ebf85a2b06f7c508aba9eaad5377e3a01e81/LICENSE.md</url>
        </license>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>robaho</id>
            <name>Robert Engels</name>
            <email>robaho@me.com</email>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/robaho/httpserver.git</url>
        <connection>scm:git:https://github.com/robaho/httpserver.git</connection>
        <developerConnection>scm:git:git@github.com:robaho/httpserver.git</developerConnection>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- javadoc fork reads this (it does not follow release=25):
             ScopedValue & friends are JDK 25 APIs -->
        <maven.compiler.source>25</maven.compiler.source>
        <!-- JDK 25 target: unlocks ScopedValue (JEP 506, final in 25) and the
             compact object headers flag in the test JVM -->
        <maven.compiler.release>25</maven.compiler.release>
        <testng.version>7.10.2</testng.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>25</release>
                </configuration>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <!-- the test sources live in the same packages as
                                 the main classes and need testng + JDK internal
                                 APIs: compile them on the CLASSPATH (unnamed
                                 module) instead of patching them into the named
                                 module, where those reads are illegal -->
                            <useModulePath>false</useModulePath>
                    <!-- surefire >= 3.5 applies its default *Test include
                         filter to suite-listed classes too, silently dropping
                         the JDK-derived default-package tests that do not
                         carry the Test suffix (InputNotRead, ZeroLength...);
                         widen the filter so the testng.xml class list is
                         authoritative -->
                    <includes>
                        <include>**/*.java</include>
                    </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- additional test source roots (parity with the old gradle
                 sourceSets): the standalone test_mains programs are compiled
                 with the tests but only run via their main() methods -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-test-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/test/extras</source>
                                <source>src/test/java_default/bugs</source>
                                <source>src/test/java_default/HttpExchange</source>
                                <source>src/test/test_mains</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>src/test/resources/testng.xml</suiteXmlFile>
                    </suiteXmlFiles>
                    <!-- the test sources (incl. the vendored jdk.test.lib)
                         compile onto the CLASSPATH (see the compiler config);
                         keep surefire running them there too. without this,
                         surefire >= 3.6 puts target/classes on the module
                         path and the vendored test lib becomes unexported
                         module content (IllegalAccessError) -->
                    <useModulePath>false</useModulePath>
                    <!-- surefire >= 3.5 applies its default *Test include
                         filter to suite-listed classes too, silently dropping
                         the JDK-derived default-package tests that do not
                         carry the Test suffix (InputNotRead, ZeroLength...);
                         widen the filter so the testng.xml class list is
                         authoritative -->
                    <includes>
                        <include>**/*.java</include>
                    </includes>
                    <!-- compact object headers (JEP 450, JDK 24+): the test JVM
                         runs with them so the code is exercised in that mode -->
                    <argLine>--add-opens=jdk.httpserver/com.sun.net.httpserver=ALL-UNNAMED -XX:+UseCompactObjectHeaders</argLine>
                    <systemPropertyVariables>
                        <java.util.logging.config.file>logging.properties</java.util.logging.config.file>
                        <com.sun.net.httpserver.HttpServerProvider>robaho.net.httpserver.DefaultHttpServerProvider</com.sun.net.httpserver.HttpServerProvider>
                        <robaho.net.httpserver.http2OverSSL>true</robaho.net.httpserver.http2OverSSL>
                        <robaho.net.httpserver.http2OverNonSSL>true</robaho.net.httpserver.http2OverNonSSL>
                        <!-- opt-in request body cap, exercised by
                             RequestBodyCapTest's four 413/kill paths. 1MB is
                             above every other test's request body (largest
                             is the 256KB h2 upload) so only the cap tests
                             hit it -->
                        <robaho.net.httpserver.maxRequestBodySize>1048576</robaho.net.httpserver.maxRequestBodySize>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- static analysis + formatting: the quality gates.
                 pmd/spotbugs run on every verify (P1-P4 gate, ruleset
                 excludes document the intentional patterns); formatter
                 is the mechanical codestyle layer so PMD can stay lean -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <!-- latest; bundles PMD engine 7.17.0 (the 7.28.0-engine CLI
                     sweep lives in the triage history; the ruleset is engine-
                     compatible across 7.x) -->
                <version>3.28.0</version>
                <configuration>
                    <rulesets>
                        <ruleset>${project.basedir}/config/pmd-ruleset.xml</ruleset>
                    </rulesets>
                    <minimumPriority>4</minimumPriority>
                    <failOnViolation>true</failOnViolation>
                    <printFailingErrors>true</printFailingErrors>
                </configuration>
                <executions>
                    <execution>
                        <id>pmd-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.10.5.0</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <excludeFilterFile>${project.basedir}/config/spotbugs-exclude.xml</excludeFilterFile>
                    <failOnError>true</failOnError>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>net.revelc.code.formatter</groupId>
                <artifactId>formatter-maven-plugin</artifactId>
                <version>2.29.0</version>
                <configuration>
                    <lineEnding>LF</lineEnding>
                    <configFile>${project.basedir}/config/formatter-eclipse.xml</configFile>
                </configuration>
                <executions>
                    <execution>
                        <id>format-sources</id>
                        <goals><goal>format</goal></goals>
                        <phase>process-sources</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-java</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <!-- fail fast with a clear message on an older
                                 JDK instead of a compiler release error -->
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.1</version>
                <configuration>
                    <!-- strict: the exported API surface is fully documented,
                         so missing/syntax/reference problems fail the build
                         instead of silently regressing -->
                    <doclint>missing,syntax,reference</doclint>
                    <!-- the javadoc fork does NOT inherit the compiler's
                         release under maven 3.9: it defaulted to 17, where
                         ScopedValue and other JDK 25 APIs do not resolve.
                         pin it explicitly -->
                    <source>25</source>
                    <release>25</release>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- release profile: sign and publish to Maven Central. credentials
             come from ~/.m2/settings.xml (central token) and gpg keyring.
             run with: mvn -Prelease deploy -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
